#!/bin/bash

# Include common functions for date validation and git commands
source "$(dirname "$0")/utils.sh"

# Ensure enough arguments are provided
if [ "$#" -lt 2 ]; then
  echo "Usage: gat <date> <git-subcommand> [options]"
  exit 1
fi

# Validate the date format
date_input="$1"
shift
validate_date "$date_input"

# Execute the git command with the provided date
execute_git_command "$date_input" "$@"

#!/bin/bash

# Include common functions
source "$(dirname "$0")/common.sh"

# Check if we have at least 2 arguments (date + git subcommand)
if [ "$#" -lt 2 ]; then
  echo "Usage: gat <date> <git-subcommand> [options]"
  exit 1
fi

# First argument is the date (could be relative or absolute)
date="$1"
shift

# Extract optional --time flag
time=$(extract_time_flag "$@")

# Validate and resolve the date
validate_date "$date"

# Apply git environment variables
apply_git_date_env "$time"

# 🔧 Execute the actual Git command
git "$@"
